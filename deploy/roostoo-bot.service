[Unit]
Description=Roostoo trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu
EnvironmentFile=/home/ubuntu/roostoo_bot/.env
ExecStart=/home/ubuntu/roostoo_bot/.venv/bin/python -m roostoo_bot.main
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/roostoo_bot/logs/bot.log
StandardError=append:/home/ubuntu/roostoo_bot/logs/bot.log

[Install]
WantedBy=multi-user.target
